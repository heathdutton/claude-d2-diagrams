direction: right

# Define styling classes (shapes and colors only - icons are added directly to nodes)
classes: {
  edge: {
    style.stroke: "#1565C0"
    style.stroke-width: 3
  }
  compute: {
    style.stroke: "#00838F"
    style.stroke-width: 3
  }
  data: {
    style.stroke: "#E65100"
    style.stroke-width: 3
  }
  messaging: {
    style.stroke: "#FF8F00"
    style.stroke-width: 3
    shape: queue
  }
  external: {
    style.stroke: "#C62828"
    style.stroke-width: 3
    shape: cloud
  }
}

# External
clients: External Clients {
  class: external
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

# AWS Cloud boundary
aws: AWS Cloud (us-east-1) {
  # Edge
  edge: Edge Layer {
    alb: Load Balancer (ALB) {
      class: edge
      shape: hexagon
    }
  }

  # Compute
  compute: Application Layer (ECS Fargate) {
    api: API Service (Go) {
      class: compute
      icon: https://icons.terrastruct.com/dev%2Fgo.svg
    }
    workers: Background Workers (Go) {
      class: compute
      icon: https://icons.terrastruct.com/dev%2Fgo.svg
    }
  }

  # Messaging
  messaging: Message Broker (MSK Kafka) {
    class: messaging
    # Note: Kafka icon URL returns 403, using shape-only
  }

  # Data
  data: Data Layer {
    database: Database (Aurora PostgreSQL) {
      class: data
      shape: cylinder
      icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg
    }
    cache: Cache (ElastiCache Redis) {
      class: data
      shape: hexagon
      icon: https://icons.terrastruct.com/dev%2Fredis.svg
    }
    sessions: Session Store (DynamoDB) {
      class: data
      shape: cylinder
      icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-DynamoDB.svg
    }
    documents: Document Store (S3) {
      class: data
      icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
    }
  }
}

# External services
monitoring: Observability (Datadog) {
  class: external
  # Note: Datadog icon not available, using cloud shape
}
cdn: CDN (CloudFront) {
  class: external
}

# Client flow
clients -> cdn: "Static assets"
cdn -> aws.edge.alb: "Origin requests"
clients -> aws.edge.alb: "API requests"
aws.edge.alb -> aws.compute.api: "Route traffic"

# API to messaging
aws.compute.api -> aws.messaging: "Publish events" {
  style.stroke-dash: 5
}

# Messaging to workers
aws.messaging -> aws.compute.workers: "Consume events" {
  style.stroke-dash: 5
}

# API to data stores
aws.compute.api -> aws.data.database: "Read/write"
aws.compute.api -> aws.data.cache: "Session cache"
aws.compute.api -> aws.data.sessions: "Auth tokens"

# Workers to data stores
aws.compute.workers -> aws.data.database: "Query data"
aws.compute.workers -> aws.data.cache: "Cache updates"
aws.compute.workers -> aws.data.documents: "File processing"

# Monitoring
aws.compute.api -> monitoring: "APM/Metrics" {
  style.stroke-dash: 3
}
aws.compute.workers -> monitoring: "APM/Metrics" {
  style.stroke-dash: 3
}
