direction: down

# Define styling classes (shapes and colors only - icons are added directly to nodes)
classes: {
  api: {
    style.stroke: "#3949AB"
    style.stroke-width: 3
  }
  processing: {
    style.stroke: "#00838F"
    style.stroke-width: 3
  }
  data: {
    style.stroke: "#E65100"
    style.stroke-width: 3
  }
  external: {
    style.stroke: "#C62828"
    style.stroke-width: 3
    shape: cloud
  }
}

# External
users: End Users (Web & Mobile) {
  class: external
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}
partners: Partner Systems (API Integrations) {
  class: external
  icon: https://icons.terrastruct.com/tech%2F022-server.svg
}

# System layers
system: Platform Core (Go Monolith) {
  # API
  gateway: API Gateway (REST + GraphQL) {
    class: api
    icon: https://icons.terrastruct.com/dev%2Fgo.svg
  }

  # Message Broker
  broker: Message Broker (Kafka) {
    class: processing
    shape: queue
    # Note: Kafka icon URL returns 403, using shape-only
  }

  # Processing
  processing: Processing Services {
    orders: Order Processor (Go) {
      class: processing
      icon: https://icons.terrastruct.com/dev%2Fgo.svg
    }
    notifications: Notification Service (Go) {
      class: processing
      icon: https://icons.terrastruct.com/dev%2Fgo.svg
    }
    analytics: Analytics Pipeline (Go) {
      class: processing
      icon: https://icons.terrastruct.com/dev%2Fgo.svg
    }
  }

  # Data
  data: Data Layer {
    primary: Primary Database (PostgreSQL) {
      class: data
      shape: cylinder
      icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg
    }
    cache: Fast Cache (Redis) {
      class: data
      shape: hexagon
      icon: https://icons.terrastruct.com/dev%2Fredis.svg
    }
    search: Search Index (Elasticsearch) {
      class: data
      shape: cylinder
    }
    files: Object Storage (S3) {
      class: data
      icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
    }
  }
}

# External services
payments: Payment Gateway (Stripe) {
  class: external
  # Note: Stripe icon not available
}
monitoring: Observability (Datadog) {
  class: external
  # Note: Datadog icon not available
}

# Data flow
users -> system.gateway: "HTTPS requests"
partners -> system.gateway: "API calls"

system.gateway -> system.data.primary: "User lookup"
system.gateway -> system.broker: "Publish commands" {
  style.stroke-dash: 5
}

system.broker -> system.processing.orders: "Order events" {
  style.stroke-dash: 5
}
system.broker -> system.processing.notifications: "Notification events" {
  style.stroke-dash: 5
}
system.broker -> system.processing.analytics: "All events" {
  style.stroke-dash: 5
}

system.processing.orders -> system.data.primary: "Order records"
system.processing.orders -> system.data.cache: "Inventory cache"
system.processing.orders -> payments: "Process payments"

system.processing.notifications -> system.data.primary: "User preferences"
system.processing.analytics -> system.data.search: "Index updates"

# Monitoring
system.gateway -> monitoring: "Traces" {
  style.stroke-dash: 3
}
system.processing.orders -> monitoring: "Traces" {
  style.stroke-dash: 3
}
